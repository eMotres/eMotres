# Example environment file for motres-forms.service.
#
# The real file lives at /etc/motres/forms.env on the server, mode 600,
# owned by root (readable by the systemd unit via EnvironmentFile=).
# Never commit the real file — this is a template with placeholder values
# only.

# Port the service listens on (127.0.0.1 only — nginx proxies to it).
PORT=8095

# Comma-separated list of origins allowed to POST from a browser.
ALLOWED_ORIGINS=https://emotres.com,https://www.emotres.com,http://localhost:3000

# Sliding-window rate limit per client IP.
RATE_LIMIT=5
RATE_WINDOW=3600

# Where submitted leads are appended as JSON lines (one object per line).
LEADS_PATH=/srv/motres/forms/leads.jsonl

# --- Mail: pick ONE of the three modes below -------------------------------
#
# Mode "auth" (needs a secret on this box):
#   Set SMTP_USER and SMTP_PASS. Requires a Google Workspace *app password*
#   for SMTP_USER (not the account password) — create one at
#   https://myaccount.google.com/apppasswords. The app password is a secret:
#   it must only ever live in /etc/motres/forms.env (mode 600), never in git.
#
# Mode "noauth" (no secret on this box):
#   Leave SMTP_USER / SMTP_PASS unset and set SMTP_NOAUTH=1 instead. This
#   uses the Google Workspace SMTP relay (smtp-relay.gmail.com:587) with this
#   server's IP allowlisted in the Workspace admin console
#   (Apps > Google Workspace > Gmail > Routing > SMTP relay). No password is
#   stored anywhere. Set SMTP_HOST=smtp-relay.gmail.com for this mode.
#
# Mode "none" (mail disabled):
#   Leave SMTP_USER, SMTP_PASS and SMTP_NOAUTH all unset/empty. Leads are
#   still stored in LEADS_PATH; no email is sent. Useful while mail is being
#   set up — the forms keep working either way.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_NOAUTH=

# Where lead notifications are sent, and the From address (defaults to
# SMTP_USER, then MAIL_TO, if left blank).
MAIL_TO=sales@emotres.com
MAIL_FROM=
